{
  "port": 3099,
  "listenHost": "0.0.0.0",
  "root": ".",
  "authToken": "",
  "allowDirs": [
    "./data"
  ],
  "uploadsDir": "./uploads",
  "shotsDir": "./shots",
  "docsDir": "./docs",
  "discovery": {
    "enabled": true,
    "intervalMs": 3000
  },
  "amap": {
    "webKey": "",
    "jsKey": "",
    "jsSecurityCode": ""
  },
  "_说明_customActions": "自定义按钮：不用改代码就能加功能。enabled 设为 true 才生效。",
  "_警告": "开启后 list 里的 command 会被真的执行 —— 这是给你自己电脑用的，别把这份配置发给别人。",
  "customActions": {
    "enabled": false,
    "list": [
      {
        "id": "lock_screen",
        "label": "锁屏",
        "group": "控制",
        "desc": "锁定电脑屏幕",
        "command": "rundll32.exe user32.dll,LockWorkStation",
        "confirm": false
      },
      {
        "id": "mute",
        "label": "静音",
        "group": "控制",
        "desc": "切换系统静音",
        "command": "powershell -NoProfile -Command \"(New-Object -ComObject WScript.Shell).SendKeys([char]173)\"",
        "confirm": false
      },
      {
        "id": "ip",
        "label": "看本机IP",
        "group": "查询",
        "desc": "显示本机所有 IPv4 地址",
        "command": "powershell -NoProfile -Command \"Get-NetIPAddress -AddressFamily IPv4 | Where-Object {$_.IPAddress -ne '127.0.0.1'} | Select-Object -ExpandProperty IPAddress\"",
        "confirm": false,
        "timeout": 15000
      }
    ]
  },
  "_说明_dsh": "手机跟电脑里的 AI（dsh）对话。默认关闭：电脑上装了并运行着 dsh 再把 enabled 改 true。图片/文件的中转目录用顶层 shotsDir（运行期名 config.shotsPath），桥拷工具截图也用它。",
  "dsh": {
    "enabled": false,
    "base": "http://127.0.0.1:3080",
    "authority": "127.0.0.1:3080",
    "home": "",
    "cwd": "",
    "webLog": "",
    "wsPath": "",
    "provider": "deepseek-official",
    "model": "deepseek-v4-flash",
    "reasoningEffort": "high",
    "agentPreset": ""
  }
}
