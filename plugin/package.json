    "dsh-plugin",
    "cordis",
    "self-hosted",
    "remote",
    "mobile",
    "push",
    "tailscale",
    "phone",
    "pc",
    "ai",
    "chat",
    "deepseek",
    "remote-access"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzheng-dev/dsh-access-phone-remote.git"
  },
  "homepage": "https://github.com/hanzheng-dev/dsh-access-phone-remote#readme",
  "bugs": {
    "url": "https://github.com/hanzheng-dev/dsh-access-phone-remote/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
